# --------------------------------------------------------------------------
# SUPABASE AYARLARI
# supabase.com -> Projeniz -> Project Settings -> API
# --------------------------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY=""

# Sunucu tarafı gizli anahtar. İstemciye veya depoya koymayın.
# Migration 20 sonrasında tüm tablo ve RPC erişimi bu anahtar üzerinden yapılır.
SUPABASE_SECRET_KEY=""

# --------------------------------------------------------------------------
# OPSİYONEL: Doğrudan PostgreSQL bağlantısı
# supabase.com -> Project Settings -> Database -> Connection String (URI / Pooler)
# --------------------------------------------------------------------------
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"
